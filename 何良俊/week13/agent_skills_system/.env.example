# DeepSeek API 配置
# ==================
# 复制本文件为 .env 并填入实际值。
# .env 不会被提交到 git（建议在 .gitignore 中加入 .env）。
#
# 也可以用环境变量直接覆盖，环境变量优先级高于 .env 文件。

# 必填：你的 DeepSeek API Key
# 获取地址: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-your-api-key-here

# 可选：API base URL（默认兼容 OpenAI 格式）
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# 可选：模型名（默认 deepseek-v4-flash，即 DeepSeek-V4 Flash 13B 激活）
# 可选值: deepseek-v4-flash / deepseek-v4-pro
# 注意: 老 deepseek-chat / deepseek-reasoner 已于 2026-07-24 停用
# DEEPSEEK_MODEL=deepseek-v4-flash

# 可选：请求超时秒数（默认 120）
# DEEPSEEK_TIMEOUT=120

# 可选：温度（默认 0.0，匹配/抽取建议保持低温）
# DEEPSEEK_TEMPERATURE=0.0
