def setup_logging():
    """配置日志系统"""
    logging.basicConfig(
        level=logging.INFO,
        format='%(asctime)s - [%(levelname)s] - %(message)s',
        datefmt='%H:%M:%S'
    )

def run_generation_task():
    """执行一次简报生成的任务"""
    print("\n" + "="*20 + " 开始执行任务 " + "="*20)
    
    # 初始化 Harness
    harness = ProgressiveHarness()
    
    # 注册技能
    harness.register_skill(GlobalAggregatorSkill())
    harness.register_skill(IntelligenceAnalyzerSkill())
    harness.register_skill(ProPublisherSkill())
    
    # 定义流水线
    pipeline = ["GlobalAggregator", "IntelligenceAnalyzer", "ProPublisher"]
    harness.create_pipeline(pipeline)
    
    # 执行
    try:
        harness.execute_pipeline()
        print("[SUCCESS] 任务完成，请检查 output_reports 目录。")
    except Exception as e:
        print(f"[ERROR] 任务执行失败: {e}")

def main():
    """主函数"""
    setup_logging()
    
    print("""
    ╔════════════════════════════════════════╗
    ║     AI Enterprise Intelligence Harness ║
    ║          企业级情报自动生成系统          ║
    ╚════════════════════════════════════════╝
    """)
    
    # 检查配置
    if SystemConfig.AI_API_KEY == "sk-your-real-api-key-here":
        print("[WARNING] 检测到您还未配置API_KEY，请在代码中修改SystemConfig类的配置。")
    
    # 设置定时任务：每天早上8:30执行
    schedule.every().day.at("08:30").do(run_generation_task)
    
    # 如果要测试，可以取消下面这行的注释，每10分钟运行一次
    # schedule.every(10).minutes.do(run_generation_task) 
    
    print("[SYSTEM] 自动值守已启动，等待执行时间...")
    print("[SYSTEM] 如需立即运行一次任务，请执行: run_generation_task()")
    print("[SYSTEM] 按 Ctrl+C 停止程序")
    
    try:
        while True:
            schedule.run_pending()
            time.sleep(60)
    except KeyboardInterrupt:
        print("\n[SYSTEM] 程序已手动停止。")

