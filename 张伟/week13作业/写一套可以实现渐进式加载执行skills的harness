class AIClient:
    """AI客户端 - 处理与OpenAI兼容API的交互"""
    
    def __init__(self):
        config = SystemConfig.get_config()
        
        self.client = openai.OpenAI(
            api_key=config.get('AI', 'API_KEY'),
            base_url=config.get('AI', 'BASE_URL')
        )
        self.model = config.get('AI', 'MODEL')
        self.logger = logging.getLogger(__name__)

    def polish_news_batch(self, news_items: List[Dict]) -> List[Dict]:
        """将一批新闻翻译并提炼为高管摘要"""
        if not news_items:
            return []

        prompt = """
你是一位专业的首席战略官(CSO)助理。请将以下全球AI领域的最新新闻资讯进行处理。
要求：
1. 翻译标题为专业的中文标题。
2. 撰写一段简短、精炼的中文摘要（不超过80字），突出商业或技术价值。
3. 返回JSON格式，包含原链接。
4. 必须保留最重要的 5 条。

输入数据格式：
Title: [英文标题]
Summary: [英文摘要]
Link: [链接]

请直接返回 JSON 列表，格式示例: [{"title": "...", "summary": "...", "link": "..."}]
"""

        input_text = ""
        for item in news_items[:10]: 
            input_text += f"Title: {item.get('title')}\nSummary: {item.get('summary')}\nLink: {item.get('link')}\n\n"

        try:
            response = self.client.chat.completions.create(
                model=self.model,
                messages=[
                    {"role": "system", "content": "你是一个专业的商业情报分析师，输出严格的JSON格式。"},
                    {"role": "user", "content": prompt + "\n" + input_text}
                ],
                temperature=0.3,
                response_format={"type": "json_object"}
            )
            content = response.choices[0].message.content
            data = json.loads(content)
            
            if isinstance(data, dict) and 'news' in data:
                return data['news']
            elif isinstance(data, list):
                return data
            else:
                self.logger.warning(f"LLM返回了意外的格式: {type(data)}")
                return []
            
        except Exception as e:
            self.logger.error(f"LLM处理失败: {e}")
            return []

