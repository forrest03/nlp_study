class GlobalAggregatorSkill(BaseSkill):
    """多源新闻聚合技能"""
    name = "GlobalAggregator"
    description = "从全球顶级科技媒体聚合AI新闻"
    priority = SkillPriority.CRITICAL
    
    SOURCES = [
        ("TechCrunch AI", "https://techcrunch.com/category/artificial-intelligence/feed/"),
        ("The Verge AI", "https://www.theverge.com/ai-artificial-intelligence/rss/index.xml"),
        ("VentureBeat AI", "https://venturebeat.com/category/ai/feed/"),
    ]

    def execute(self, input_data: Optional[str], context: Optional[ExecutionContext] = None):
        logger = logging.getLogger(__name__)
        logger.info(f"开始从 {len(self.SOURCES)} 个源头聚合数据...")
        
        raw_news = []
        seen_titles = set()

        for source_name, url in self.SOURCES:
            try:
                logger.info(f"正在连接 {source_name}...")
                feed = feedparser.parse(url)
                
                for entry in feed.entries[:5]:
                    title = entry.get('title', '')
                    if title in seen_titles:
                        continue
                    seen_titles.add(title)
                    
                    summary = entry.get('summary', entry.get('description', ''))
                    import re
                    clean_summary = re.sub('<[^<]+?>', '', summary)
                    
                    raw_news.append({
                        'title': title,
                        'summary': clean_summary,
                        'link': entry.get('link'),
                        'source': source_name,
                        'date': datetime.now()
                    })
                    
            except Exception as e:
                logger.warning(f"抓取 {source_name} 失败: {e}")

        logger.info(f"聚合完成，原始数据量: {len(raw_news)}")
        
        if context:
            context.set("raw_news", raw_news)
            
        return f"聚合完成，共 {len(raw_news)} 条原始资讯"

class IntelligenceAnalyzerSkill(BaseSkill):
    """智能分析技能 - 包含降级保底"""
    name = "IntelligenceAnalyzer"
    description = "基于 LLM 翻译并提炼商业价值（含降级保底）"
    priority = SkillPriority.HIGH
    dependencies = ["GlobalAggregator"]

    def execute(self, input_data: Optional[str], context: Optional[ExecutionContext] = None):
        logger = logging.getLogger(__name__)
        logger.info("正在启动 AI 分析引擎...")
        
        raw_news = context.get("raw_news", []) if context else []
        
        if not raw_news:
            logger.warning("原始新闻为空，跳过分析。")
            if context:
                context.set("final_news", [])
            return "无数据可分析"

        try:
            ai_client = AIClient()
            polished = ai_client.polish_news_batch(raw_news)
            if polished and isinstance(polished, list):
                cleaned = [
                    {k: item.get(k) for k in ("title", "summary", "link")}
                    for item in polished if isinstance(item, dict)
                ]
                if cleaned:
                    context.set("final_news", cleaned)
                    logger.info(f"分析完成，产出 {len(cleaned)} 条高价值简报")
                    return f"分析完成，产出 {len(cleaned)} 条"
        except Exception as e:
            logger.warning(f"LLM 分析失败，将降级使用本地处理: {e}")

        # 降级保底：本地简单翻译标题+摘要
        translator = GoogleTranslator(source='auto', target='zh-CN')
        fallback_news = []
        for item in raw_news[:5]:
            try:
                title_zh = translator.translate(item.get('title', ''))[:120]
                summary_zh = translator.translate(item.get('summary', ''))[:180]
            except Exception:
                title_zh = item.get('title', '')[:120]
                summary_zh = item.get('summary', '')[:180]
            fallback_news.append({
                "title": title_zh,
                "summary": summary_zh,
                "link": item.get('link', '#')
            })
        context.set("final_news", fallback_news)
        logger.info(f"降级模式已产出 {len(fallback_news)} 条简报")
        return f"降级模式完成，产出 {len(fallback_news)} 条"

class ProPublisherSkill(BaseSkill):
    """专业Word生成技能"""
    name = "ProPublisher"
    description = "生成企业级 Word 简报"
    priority = SkillPriority.NORMAL
    dependencies = ["IntelligenceAnalyzer"]

    def execute(self, input_data: Optional[str], context: Optional[ExecutionContext] = None):
        logger = logging.getLogger(__name__)
        
        news_list = context.get("final_news", []) if context else []
        
        # 鲁棒性处理：如果数据为空，生成占位内容
        if not news_list:
            logger.warning("最终新闻列表为空，将生成占位报告")
            news_list = [{
                "title": "暂无最新进展",
                "summary": "当前时段未获取到有效新闻资讯。请检查网络连接、API配置或稍后重试。",
                "link": "#"
            }]

        config = SystemConfig.get_config()
        output_dir = config.get('SYSTEM', 'OUTPUT_DIR', fallback='output_reports')
        os.makedirs(output_dir, exist_ok=True)

        doc = Document()
        
        # 页面设置
        section = doc.sections[0]
        section.page_width = Cm(21.0)
        section.page_height = Cm(29.7)
        section.top_margin = Cm(2.5)
        section.bottom_margin = Cm(2.0)
        section.left_margin = Cm(3.0)
        section.right_margin = Cm(2.0)

        # 样式函数
        def set_font(run, name, size, bold=False, color=RGBColor(0,0,0)):
            run.font.name = name
            run._element.rPr.rFonts.set(qn('w:eastAsia'), name)
            run.font.size = Pt(size)
            run.font.bold = bold
            run.font.color.rgb = color

        # 标题区域
        title = doc.add_heading()
        title.alignment = WD_ALIGN_PARAGRAPH.CENTER
        run_title = title.add_run("全球人工智能产业动态监测简报")
        set_font(run_title, "黑体", 22, bold=True, color=RGBColor(0, 51, 102))
        
        # 元数据
        meta = doc.add_paragraph()
        meta.alignment = WD_ALIGN_PARAGRAPH.CENTER
        date_str = datetime.now().strftime("%Y年%m月%d日")
        week_str = datetime.now().isocalendar()[1]
        meta_text = f"日期：{date_str}    期数：2024年第 {week_str} 期    密级：内部公开"
        run_meta = meta.add_run(meta_text)
        set_font(run_meta, "仿宋_GB2312", 14, color=RGBColor(50, 50, 50))
        
        # 分割线
        doc.add_paragraph().add_run("─" * 60).alignment = WD_ALIGN_PARAGRAPH.CENTER

        # 正文内容
        for idx, item in enumerate(news_list, 1):
            # 小标题
            p_head = doc.add_paragraph()
            p_head.space_before = Pt(12)
            p_head.space_after = Pt(6)
            run_head = p_head.add_run(f"{idx}. {item.get('title', 'No Title')}")
            set_font(run_head, "微软雅黑", 12, bold=True, color=RGBColor(0, 0, 0))
            
            # 摘要
            p_body = doc.add_paragraph()
            p_body.line_spacing = 1.5
            p_body.space_after = Pt(12)
            run_body = p_body.add_run(item.get('summary', 'No Summary'))
            set_font(run_body, "宋体", 10.5)
            
            # 链接
            p_link = doc.add_paragraph()
            run_link = p_link.add_run(f"来源链接: {item.get('link', '#')}")
            set_font(run_link, "Arial", 8, color=RGBColor(150, 150, 150))
            p_link.paragraph_format.space_after = Pt(18)

        # 页脚
        doc.add_page_break()
        footer = doc.add_paragraph()
        footer.alignment = WD_ALIGN_PARAGRAPH.CENTER
        run_foot = footer.add_run("本简报由 AI 自动生成，内容来源于公开互联网，仅供内部决策参考。")
        set_font(run_foot, "楷体", 10.5)

        # 保存文件
        filename = f"{output_dir}/AI_Briefing_{datetime.now().strftime('%Y%m%d')}.docx"
        doc.save(filename)
        
        logger.info(f"报告已生成: {filename}")
        return f"报告已生成: {filename}"

