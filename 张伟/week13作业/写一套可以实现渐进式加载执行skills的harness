class SkillPriority(Enum):
    """技能优先级枚举"""
    CRITICAL = 0
    HIGH = 1
    NORMAL = 2
    LOW = 3

class ExecutionContext:
    """执行上下文 - 用于在技能之间传递数据"""
    def __init__(self):
        self._data: Dict[str, Any] = {}

    def set(self, key: str, value: Any):
        self._data[key] = value

    def get(self, key: str, default: Any = None) -> Any:
        return self._data.get(key, default)

    def has(self, key: str) -> bool:
        return key in self._data

    def clear(self):
        self._data.clear()

class BaseSkill(ABC):
    """所有技能的抽象基类"""
    name: str = "BaseSkill"
    description: str = "No description"
    priority: SkillPriority = SkillPriority.NORMAL
    dependencies: List[str] = []

    def __init__(self):
        self.logger = logging.getLogger("AI_Harness.Skills")

    @abstractmethod
    def execute(self, input_data: Optional[str], context: ExecutionContext):
        """执行技能的具体逻辑"""
        pass

    def validate_context(self, context: ExecutionContext, required_keys: List[str]):
        """检查上下文中是否存在必要的数据"""
        missing = [k for k in required_keys if not context.has(k)]
        if missing:
            raise ValueError(f"Context validation failed. Missing keys: {missing}")

