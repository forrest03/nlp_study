class ProgressiveHarness:
    """渐进式加载执行引擎"""
    
    def __init__(self):
        self._skills: Dict[str, Any] = {}
        self._pipeline: List[str] = []
        self.logger = logging.getLogger("AI_Harness")

    def register_skill(self, skill_instance: BaseSkill):
        """注册技能实例到引擎中"""
        name = skill_instance.name
        if not name:
            raise ValueError("Skill must have a name")
        self._skills[name] = skill_instance
        self.logger.info(f"Registered Skill: {name}")

    def create_pipeline(self, skill_names: List[str]):
        """定义执行流水线顺序"""
        self._pipeline = skill_names
        self.logger.info(f"Pipeline created: {' -> '.join(skill_names)}")

    def execute_pipeline(self, initial_input: str = None):
        """按顺序执行流水线中的所有技能"""
        if not self._pipeline:
            self.logger.error("Pipeline is empty. Cannot execute.")
            return

        context = ExecutionContext()
        current_output = initial_input
        
        self.logger.info("=" * 20 + " PIPELINE START " + "=" * 20)

        for skill_name in self._pipeline:
            if skill_name not in self._skills:
                self.logger.error(f"Skill '{skill_name}' not found in registry.")
                continue
            
            skill = self._skills[skill_name]
            
            try:
                self.logger.info(f"Executing: {skill_name}...")
                current_output = skill.execute(current_output, context)
                self.logger.info(f"Finished: {skill_name}")
            except Exception as e:
                self.logger.error(f"Error executing {skill_name}: {e}", exc_info=True)
                raise

        self.logger.info("=" * 20 + " PIPELINE COMPLETE " + "=" * 20)
        return current_output

