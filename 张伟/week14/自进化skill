class KeywordTranslator:
    """智能翻译器：自动将中文关键词转为英文"""
    
    def __init__(self):
        self.keyword_map = {
            "人工智能": "artificial intelligence",
            "自进化": "self-evolving OR self-improving",
            "进化": "evolutionary",
            "机器学习": "machine learning",
            "深度学习": "deep learning",
            "强化学习": "reinforcement learning",
            "神经网络": "neural network",
            "自然语言处理": "natural language processing",
            "计算机视觉": "computer vision",
            "大模型": "large language model",
            "语言模型": "language model",
            "智能体": "agent OR agents",
            "多智能体": "multi-agent",
            "机器人": "robot OR robotics",
            "优化": "optimization",
            "算法": "algorithm",
            "数据挖掘": "data mining",
            "知识图谱": "knowledge graph",
            "推荐系统": "recommendation system",
            "联邦学习": "federated learning",
            "迁移学习": "transfer learning",
            "生成模型": "generative model",
            "对抗网络": "GAN OR generative adversarial network",
            "注意力机制": "attention mechanism",
            "图神经网络": "graph neural network",
            "元学习": "meta-learning",
            "小样本学习": "few-shot learning",
            "预训练": "pre-training OR pretrained",
            "微调": "fine-tuning",
            "提示学习": "prompt learning",
            "检索增强": "retrieval-augmented",
            "智能体系统": "agent system",
            "自主智能体": "autonomous agent"
        }
        
        self.llm = None
    
    def _get_llm(self):
        """延迟初始化 LLM"""
        if self.llm is None:
            self.llm = ChatOpenAI(
                temperature=0.1,
                openai_api_key=DEEPSEEK_API_KEY,
                openai_api_base=DEEPSEEK_BASE_URL,
                model_name=DEEPSEEK_MODEL
            )
        return self.llm
    
    def contains_chinese(self, text: str) -> bool:
        """检测是否包含中文"""
        return bool(re.search(r'[\u4e00-\u9fff]', text))
    
    def translate(self, query: str) -> str:
        """翻译关键词"""
        if not self.contains_chinese(query):
            return query
        
        print(f"🔤 检测到中文关键词，正在翻译...")
        
        # 1. 词汇表翻译
        translated = self._dictionary_translate(query)
        if translated:
            print(f"✅ 词汇表翻译: {query} → {translated}")
            return translated
        
        # 2. LLM 翻译
        translated = self._llm_translate(query)
        if translated:
            print(f"✅ AI翻译: {query} → {translated}")
            return translated
        
        return query
    
    def _dictionary_translate(self, query: str) -> Optional[str]:
        """词汇表翻译"""
        if query in self.keyword_map:
            return self.keyword_map[query]
        
        result = query
        for cn, en in self.keyword_map.items():
            if cn in result:
                result = result.replace(cn, en)
        
        if result != query:
            return result
        
        return None
    
    def _llm_translate(self, query: str) -> Optional[str]:
        """使用 LLM 翻译"""
        prompt = f"""你是一个学术翻译专家。请将以下中文关键词翻译成适合在 arXiv 搜索的英文关键词。

要求：
1. 使用学术常用术语
2. 如果有多个相关术语，用 OR 连接
3. 只返回翻译结果，不要解释

中文关键词：{query}

英文关键词："""
        
        try:
            llm = self._get_llm()
            messages = [HumanMessage(content=prompt)]
            response = llm.invoke(messages)
            
            translated = response.content.strip()
            translated = translated.replace("英文关键词：", "").strip()
            
            return translated
            
        except Exception as e:
            print(f"翻译失败: {e}")
            return None

