        self.embeddings = LocalEmbeddings()
        self.vector_store = self._init_vector_store()
        
        # LLM 实例（用于模板重写）
        self.llm = None
    
    def _get_llm(self):
        """延迟初始化 LLM"""
        if self.llm is None:
            self.llm = ChatOpenAI(
                temperature=0.3,  # 稍高的温度促进创新
                openai_api_key=DEEPSEEK_API_KEY,
                openai_api_base=DEEPSEEK_BASE_URL,
                model_name=DEEPSEEK_MODEL
            )
        return self.llm
    
    def _load(self, filename: str, default):
        """安全加载JSON文件"""
        path = os.path.join(self.storage_path, filename)
        if os.path.exists(path):
            try:
                return json.load(open(path, "r", encoding="utf-8"))
            except:
                pass
        return default
    
    def _save(self, filename: str, data):
        """保存数据"""
        path = os.path.join(self.storage_path, filename)
        json.dump(data, open(path, "w", encoding="utf-8"), indent=2, ensure_ascii=False)
    
    def _init_vector_store(self):
        """初始化向量存储"""
        if not self.execution_history:
            return None
        
        texts = [h["query"] + " " + h.get("result_summary", "") for h in self.execution_history]
        metadatas = [{
            "id": h["id"],
            "success": h["success"],
            "rating": h.get("user_rating", 0)
        } for h in self.execution_history]
        
        return FAISS.from_texts(texts, self.embeddings, metadatas=metadatas)
    
    def record_execution(self, skill_type: str, query: str, result: str, success: bool):
        """记录执行历史"""
        record = {
            "id": hashlib.md5(f"{time.time()}_{query}".encode()).hexdigest()[:12],
            "timestamp": datetime.now().isoformat(),
            "skill_type": skill_type,
            "query": query,
            "result_summary": result[:200],
            "success": success,
            "user_rating": 0
        }
        
        self.execution_history.append(record)
        self._save("execution_history.json", self.execution_history)
        
        if self.vector_store is None:
            self.vector_store = FAISS.from_texts([query], self.embeddings, metadatas=[{"id": record["id"]}])
        else:
            self.vector_store.add_texts([query], metadatas=[{"id": record["id"]}])
        
        return record["id"]
    
    def rate_execution(self, execution_id: str, rating: int, feedback: str = ""):
        """用户评分触发进化"""
        for record in self.execution_history:
            if record["id"] == execution_id:
                record["user_rating"] = rating
                record["user_feedback"] = feedback
                
                if rating >= 4:
                    self._evolve_from_success(record)
                else:
                    self._learn_from_failure(record)
                
                break
        
        self._save("execution_history.json", self.execution_history)
    
    def _evolve_from_success(self, record: Dict):
        """从成功案例中进化（激进策略）"""
        skill_type = record["skill_type"]
        
        if skill_type not in self.skill_templates:
            return
        
        # 检查连续成功次数
        recent_success = [
            r for r in self.execution_history[-10:] 
            if r["skill_type"] == skill_type and r.get("user_rating", 0) >= 4
        ]
        
        # 激进策略：连续成功2次就进化（原来是3次）
        if len(recent_success) >= 2:
            old_version = self.skill_templates[skill_type]["version"]
            new_version = old_version + 1
            
            # 记录进化前状态（用于回滚）
            evolution_record = {
                "timestamp": datetime.now().isoformat(),
                "trigger": f"连续成功{len(recent_success)}次",
                "from_version": old_version,
                "to_version": new_version,
                "previous_template": self.skill_templates[skill_type]["template"],
                "success_cases": [
                    {"query": r["query"], "rating": r["user_rating"]} 
                    for r in recent_success[-3:]
                ]
            }
            
            print(f"\n🎉 触发激进进化！{skill_type} v{old_version} → v{new_version}")
            print("🧬 正在调用 LLM 重写提示词模板...")
            
            # 🔥 核心：让 LLM 重写模板
            new_template = self._evolve_template_content(skill_type, recent_success)
            
            if new_template:
                self.skill_templates[skill_type]["template"] = new_template
                self.skill_templates[skill_type]["version"] = new_version
                evolution_record["improvement"] = "LLM自动重写模板"
                evolution_record["new_template_preview"] = new_template[:200] + "..."
                
                print("✅ 模板已重写并保存！")
            else:
                evolution_record["improvement"] = "模板重写失败，保留原模板"
                print("⚠️ 模板重写失败，保留原模板")
            
            self.skill_templates[skill_type]["evolution_history"].append(evolution_record)
            self._save("skill_templates.json", self.skill_templates)
    
    def _evolve_template_content(self, skill_type: str, success_cases: List[Dict]) -> Optional[str]:
        """🔥 核心：让 LLM 自己改写提示词模板"""
        
        try:
            llm = self._get_llm()
            
            # 构建进化提示词
            evolution_prompt = f"""你是一个AI进化专家，擅长优化提示词模板。

当前模板：
{self.skill_templates[skill_type]["template"]}

