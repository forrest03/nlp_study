class ResearchAssistant:
    """实战研究助手（激进进化版）"""
    
    def __init__(self):
        self.memory = EvolutionaryMemory()
        self.arxiv = ArxivSearchEngine()
        self.llm = ChatOpenAI(
            temperature=0.2,
            openai_api_key=DEEPSEEK_API_KEY,
            openai_api_base=DEEPSEEK_BASE_URL,
            model_name=DEEPSEEK_MODEL
        )
    
    def literature_survey(self, query: str, max_papers: int = 10) -> Dict:
        print(f"\n{'='*60}")
        print(f"📚 执行文献综述: {query}")
        print(f"{'='*60}")
        
        similar_cases = self.memory.get_similar_cases(query)
        if similar_cases:
            print(f"🔍 找到 {len(similar_cases)} 个相似历史案例")
        
        papers = self.arxiv.search(query, max_papers)
        
        if not papers:
            return {"success": False, "error": "未找到相关论文，请尝试其他关键词"}
        
        profile = self.memory.user_profile
        template = self.memory.skill_templates["literature_survey"]["template"]
        
        # 显示当前版本
        version = self.memory.skill_templates["literature_survey"]["version"]
        print(f"📌 使用模板版本: v{version}")
        
        prompt = template.format(
            background=", ".join(profile["research_interests"]) or "AI研究",
            focus=", ".join(profile["style_preferences"]["focus_areas"]),
            quality=str(profile["quality_thresholds"]),
            papers=json.dumps(papers, indent=2, ensure_ascii=False)
        )
        
        print(f"\n🤖 DeepSeek 正在生成综述...")
        
        try:
            messages = [
                SystemMessage(content="你是一位专业的AI研究助手，擅长文献综述和研究分析。请用中文回答。"),
                HumanMessage(content=prompt)
            ]
            
            response = self.llm.invoke(messages)
            result = response.content
            
            exec_id = self.memory.record_execution("literature_survey", query, result, True)
            
            return {
                "success": True,
                "execution_id": exec_id,
                "result": result,
                "papers_found": len(papers),
                "papers": papers,
                "template_version": version
            }
            
        except Exception as e:
            self.memory.record_execution("literature_survey", query, str(e), False)
            return {"success": False, "error": str(e)}
    
    def analyze_paper(self, arxiv_url: str) -> Dict:
        print(f"\n{'='*60}")
        print(f"📄 深度分析论文")
        print(f"{'='*60}")
        
        arxiv_id = arxiv_url.split("/")[-1]
        papers = self.arxiv.search(f"id:{arxiv_id}", max_results=1)
        
        if not papers:
            return {"success": False, "error": "论文未找到"}
        
        paper = papers[0]
        
        template = self.memory.skill_templates["paper_analysis"]["template"]
        profile = self.memory.user_profile
        
        version = self.memory.skill_templates["paper_analysis"]["version"]
        print(f"📌 使用模板版本: v{version}")
        
        prompt = template.format(
            background=", ".join(profile["research_interests"]),
            focus=", ".join(profile["style_preferences"]["focus_areas"]),
            paper=json.dumps(paper, indent=2, ensure_ascii=False)
        )
        
        try:
            messages = [
                SystemMessage(content="你是AI研究专家，擅长深度分析论文。请用中文回答。"),
                HumanMessage(content=prompt)
            ]
            
            response = self.llm.invoke(messages)
            result = response.content
            
            exec_id = self.memory.record_execution("paper_analysis", arxiv_url, result, True)
            
            return {
                "success": True,
                "execution_id": exec_id,
                "result": result,
                "paper": paper,
                "template_version": version
            }
            
        except Exception as e:
            return {"success": False, "error": str(e)}
    
    def set_research_interests(self, interests: List[str]):
        self.memory.user_profile["research_interests"] = interests
        self.memory._save("user_profile.json", self.memory.user_profile)
        print(f"✅ 已更新研究方向: {', '.join(interests)}")
    
    def rate_result(self, execution_id: str, rating: int, feedback: str = ""):
        self.memory.rate_execution(execution_id, rating, feedback)
        
        if rating >= 4:
            print(f"⭐ 感谢好评！系统将学习您的偏好并进化...")
        else:
            print(f"📝 感谢反馈！系统会改进...")

