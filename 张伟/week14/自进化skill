            messages = [
                SystemMessage(content="你是提示词工程专家，擅长优化AI助手的提示词模板。"),
                HumanMessage(content=evolution_prompt)
            ]
            
            response = llm.invoke(messages)
            new_template = response.content.strip()
            
            # 验证模板有效性（至少包含基本结构）
            if len(new_template) > 100 and "{" in new_template and "}" in new_template:
                return new_template
            else:
                print("⚠️ 生成的模板格式不正确")
                return None
                
        except Exception as e:
            print(f"❌ 模板重写失败: {e}")
            return None
    
    def _learn_from_failure(self, record: Dict):
        """从失败中学习"""
        rule = {
            "timestamp": datetime.now().isoformat(),
            "skill_type": record["skill_type"],
            "issue": record.get("user_feedback", "用户不满意"),
            "solution": "需要改进"
        }
        self.learned_rules.append(rule)
        self._save("learned_rules.json", self.learned_rules)
    
    def get_similar_cases(self, query: str, k: int = 3) -> List[Dict]:
        """获取相似历史案例"""
        if self.vector_store is None:
            return []
        
        docs = self.vector_store.similarity_search(query, k=k)
        return [doc.metadata for doc in docs]
    
    def get_evolution_report(self) -> Dict:
        """获取进化报告"""
        return {
            "total_executions": len(self.execution_history),
            "successful_executions": sum(1 for r in self.execution_history if r["success"]),
            "avg_rating": sum(r.get("user_rating", 0) for r in self.execution_history) / max(len(self.execution_history), 1),
            "skill_versions": {
                skill: data["version"] 
                for skill, data in self.skill_templates.items()
            },
            "learned_rules_count": len(self.learned_rules),
            "evolution_history_length": sum(len(data.get("evolution_history", [])) for data in self.skill_templates.values())
        }
    
    def rollback_skill(self, skill_type: str, target_version: int) -> bool:
        """回滚技能到指定版本"""
        if skill_type not in self.skill_templates:
            return False
        
        history = self.skill_templates[skill_type].get("evolution_history", [])
        
        for record in reversed(history):
            if record.get("to_version") == target_version:
                # 恢复之前的模板
                if "previous_template" in record:
                    self.skill_templates[skill_type]["template"] = record["previous_template"]
                    self.skill_templates[skill_type]["version"] = target_version
                    
                    # 记录回滚操作
                    rollback_record = {
                        "timestamp": datetime.now().isoformat(),
                        "trigger": "用户手动回滚",
                        "from_version": record["from_version"],
                        "to_version": target_version,
                        "improvement": "回滚到历史版本"
                    }
                    self.skill_templates[skill_type]["evolution_history"].append(rollback_record)
                    
                    self._save("skill_templates.json", self.skill_templates)
                    print(f"✅ 已回滚 {skill_type} 到 v{target_version}")
                    return True
        
        return False

