    def switch_mode(self):
        """V6.0 模式切换"""
        mode = self.mode_var.get()
        hints = {
            "news": "请输入新闻素材（建议200字以内）",
            "book": "请输入书名及简介（如：《三体》刘慈欣著，讲述...）",
            "movie": "请输入电影名称（如：《肖申克的救赎》）"
        }
        self.input_label.config(text=hints.get(mode, ""))
        
    def log(self, message):
        self.log_area.insert(tk.END, f"[{datetime.datetime.now().strftime('%H:%M:%S')}] {message}\n")
        self.log_area.see(tk.END)
        self.root.update()
        
    def call_api(self, api_key, prompt, max_tokens=4000):
        """V6.0 统一API调用"""
        url = "https://api.deepseek.com/chat/completions"
        headers = {
            "Content-Type": "application/json",
            "Authorization": f"Bearer {api_key}"
        }
        payload = {
            "model": "deepseek-chat",
            "messages": [{"role": "user", "content": prompt}],
            "temperature": 0.7,
            "max_tokens": max_tokens
        }
        try:
            response = requests.post(url, headers=headers, json=payload, timeout=180)
            response.raise_for_status()
            return response.json()['choices'][0]['message']['content']
        except Exception as e:
            return f"API_ERROR: {str(e)}"
            
    # ====== V6.0 三大模块 ======
    
    def process_news(self, api_key, content):
        """时事评论模块"""
        self.log("▶ 模式：时事评论")
        
        # 生成摘要
        summary = self.call_api(api_key, f"用15字内概括事件，无标点：\n{content}", max_tokens=50)
        if "API_ERROR" in summary: return None, None
        summary = summary.replace("\n", "").strip()
        self.log(f"✓ 事件摘要：{summary}")
        
        # 生成正文
        prompt = f"""
你是人民日报资深评论员。请根据以下素材撰写社论。
【要求】：政治站位高、逻辑严密、语言凝练。
【字数】：严格控制在1450-1550字。
素材：{content}
"""
        self.log("✓ 正在撰写社论...")
        article = self.call_api(api_key, prompt, max_tokens=2500)
        
        filename = f"{datetime.datetime.now().strftime('%Y年%m月%d日%H时%M分%S秒')}社评—{summary}.txt"
        return article, filename
        
    def process_book(self, api_key, content):
        """书评模块 - V6.0 优化至3000字"""
        self.log("▶ 模式：文艺书评")
        
        # V6.0 核心：提取书名和作者（防重机制）
        extract_prompt = f"""
从以下信息中提取书名和作者，格式：书名|作者
如果无法确定作者，写"佚名"。
信息：{content}
只返回格式化的结果，不要其他内容。
"""
        book_info = self.call_api(api_key, extract_prompt, max_tokens=100)
        if "API_ERROR" in book_info: return None, None
        
        try:
            parts = book_info.split("|")
            book_name = parts[0].strip() if len(parts) > 0 else "未知书名"
            author = parts[1].strip() if len(parts) > 1 else "佚名"
        except:
            book_name, author = "未知书名", "佚名"
        
        self.log(f"✓ 识别结果：《{book_name}》-{author}")
        
        # V6.0 调整：3000字以内
        prompt = f"""
你是一位人文素养深厚的文学评论家。
请为《{book_name}》撰写一篇深度书评。
【风格要求】：文艺范、深情、哲思，拒绝官样文章。
【字数要求】：控制在3000字以内。
【内容建议】：可从主题、人物、语言、思想等角度展开。
书籍信息：{content}
"""
        self.log("✓ 正在撰写书评...")
        article = self.call_api(api_key, prompt, max_tokens=4000)
        
        # V6.0 核心：防重命名格式
        safe_author = re.sub(r'[\\/:*?"<>|]', '', author)
        safe_book = re.sub(r'[\\/:*?"<>|]', '', book_name)
        
        filename = f"**********书评*******{safe_author}{safe_book}.txt"
        return article, filename
        
    def process_movie(self, api_key, content):
        """V6.0 新增：影评模块"""
        self.log("▶ 模式：电影评论")
        
        movie_name = content.strip()
        self.log(f"✓ 影片：《{movie_name}》")
        
        prompt = f"""
你是一位资深电影评论家。
请为电影《{movie_name}》撰写一篇专业影评。
【风格要求】：专业、深入、有见地，可涉及镜头语言、叙事结构、主题表达等。
【字数要求】：2000字左右。
【内容建议】：结合电影具体情节进行分析，避免泛泛而谈。
"""
        self.log("✓ 正在撰写影评...")
        article = self.call_api(api_key, prompt, max_tokens=3000)
        
        safe_name = re.sub(r'[\\/:*?"<>|]', '', movie_name)[:20]
        filename = f"{datetime.datetime.now().strftime('%Y年%m月%d日%H时%M分%S秒')}影评—{safe_name}.txt"
        
        return article, filename
        
    def run_generation(self):
        api_key = self.api_entry.get().strip()
        if not api_key:
            messagebox.showerror("错误", "请输入 API Key")
            return
            
        content = self.text_input.get("1.0", tk.END).strip()
        if not content:
            messagebox.showerror("错误", "请输入内容")
            return
            
        self.run_btn.config(state=tk.DISABLED, text="⏳ 正在生成中...")
        
        try:
            mode = self.mode_var.get()
            
            if mode == "news":
                article, filename = self.process_news(api_key, content)
            elif mode == "book":
                article, filename = self.process_book(api_key, content)
            else:
                article, filename = self.process_movie(api_key, content)
                
            if article and "API_ERROR" not in article:
                # 保存文件
                folder = "写作助手输出"
                if not os.path.exists(folder):
                    os.makedirs(folder)
                path = os.path.join(folder, filename)
                
                with open(path, 'w', encoding='utf-8') as f:
                    f.write(article)
                    
                wc = len(article.replace(" ", "").replace("\n", ""))
                self.log(f"✓ 文件已保存: {filename}")
                self.log(f"✓ 总字数: {wc} 字")
                messagebox.showinfo("生成完成", f"文件已保存！\n字数：{wc}\n路径：{os.path.abspath(path)}")
            else:
                messagebox.showerror("失败", f"生成出错: {article}")
        finally:
            self.run_btn.config(state=tk.NORMAL, text="🚀 开始生成")


