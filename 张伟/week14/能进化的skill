# ==============================================================================
#                           VERSION 1.0 - 基础原型
# ==============================================================================
"""
【V1.0 特征】
- 功能：自动爬取微博热搜，生成人民日报风格社论
- 技术栈：requests + BeautifulSoup + GUI (tkinter)
- 输入：无（自动爬取）
- 输出：固定文件名
- 局限：依赖微博API稳定性，易崩溃
- 进化点：建立了基本的 GUI 框架和文件保存逻辑
"""

import tkinter as tk
from tkinter import messagebox
import datetime
import os
import requests
from bs4 import BeautifulSoup
import json

class PeopleDailyAgentV1:
    """V1.0 - 基础版写作 Skill"""
    
    def __init__(self, root):
        self.root = root
        self.root.title("人民评论写作Agent V1.0")
        self.root.geometry("600x500")
        
        # 标题
        tk.Label(root, text="人民评论写作Agent", 
                font=("SimHei", 18, "bold")).pack(pady=20)
        
        # API Key 输入
        tk.Label(root, text="API Key:").pack()
        self.api_entry = tk.Entry(root, width=40)
        self.api_entry.pack(pady=5)
        
        # 运行按钮
        self.run_btn = tk.Button(root, text="生成今日社论", 
                                 command=self.run_agent)
        self.run_btn.pack(pady=20)
        
        # 状态显示
        self.status_label = tk.Label(root, text="等待开始...")
        self.status_label.pack()
        
    def get_weibo_hotsearch(self):
        """爬取微博热搜 - V1.0 的核心功能"""
        try:
            url = "https://weibo.com/ajax/statuses/hot/search"
            headers = {"User-Agent": "Mozilla/5.0"}
            response = requests.get(url, headers=headers)
            data = response.json()
            return data['data']['realtime'][:5]  # 取前5条
        except Exception as e:
            return None
            
    def generate_commentary(self, news_item, api_key):
        """生成评论 - V1.0 基础生成逻辑"""
        # 这里使用简单的文本生成逻辑
        prompt = f"请对以下新闻写一段评论：{news_item}"
        # 实际调用会连接 API
        return f"关于【{news_item}】的评论内容..."
        
    def save_file(self, content):
        """V1.0 文件保存 - 固定文件名"""
        filename = f"社评_{datetime.datetime.now().strftime('%Y%m%d')}.txt"
        with open(filename, 'w', encoding='utf-8') as f:
            f.write(content)
        return filename
        
    def run_agent(self):
        """V1.0 主运行逻辑"""
        self.status_label.config(text="正在爬取热搜...")
        hot_search = self.get_weibo_hotsearch()
        
        if not hot_search:
            messagebox.showerror("错误", "爬取失败")
            return
            
        self.status_label.config(text="正在生成评论...")
        # 简化处理，实际会更复杂
        content = "今日社评内容..."
        
        filename = self.save_file(content)
        self.status_label.config(text=f"已完成，文件：{filename}")
        messagebox.showinfo("完成", f"文件已保存：{filename}")


# ==============================================================================
#                           VERSION 2.0 - API 稳定化
# ==============================================================================
"""
【V2.0 进化点】
- 问题：V1.0 的微博爬虫不稳定，容易崩溃
- 解决：切换至 DeepSeek API，提供稳定的服务
- 新增：API Key 输入框（隐藏显示）
- 优化：错误处理机制
- 进化意义：从"依赖特定数据源"到"通用文本生成能力"
"""

class PeopleDailyAgentV2:
    """V2.0 - API 稳定版"""
    
    def __init__(self, root):
        self.root = root
        self.root.title("人民评论写作Agent V2.0")
        self.root.geometry("600x500")
        
        tk.Label(root, text="人民评论写作Agent V2.0", 
                font=("SimHei", 18, "bold")).pack(pady=20)
        
        # API Key 输入 - V2.0 新增安全显示
        tk.Label(root, text="DeepSeek API Key:").pack()
        self.api_entry = tk.Entry(root, width=40, show="*")  # 隐藏显示
        self.api_entry.pack(pady=5)
        
        self.run_btn = tk.Button(root, text="🚀 接入AI，生成今日社论", 
                                 command=self.run_agent,
                                 bg="#0055AA", fg="white")
        self.run_btn.pack(pady=20)
        
        self.log_text = tk.Text(root, height=10, width=50)
        self.log_text.pack()
        
    def call_deepseek_api(self, api_key, prompt):
        """V2.0 核心：DeepSeek API 调用封装"""
        url = "https://api.deepseek.com/chat/completions"
        headers = {
            "Content-Type": "application/json",
            "Authorization": f"Bearer {api_key}"
        }
        payload = {
            "model": "deepseek-chat",
            "messages": [{"role": "user", "content": prompt}],
            "max_tokens": 2000
        }
        
        try:
            response = requests.post(url, headers=headers, json=payload, timeout=60)
            response.raise_for_status()
            return response.json()['choices'][0]['message']['content']
        except Exception as e:
            return f"ERROR: {str(e)}"
            
    def log(self, message):
        """V2.0 新增：日志功能"""
        self.log_text.insert(tk.END, f"{message}\n")
        self.root.update()
        
    def run_agent(self):
        api_key = self.api_entry.get().strip()
        if not api_key:
            messagebox.showerror("错误", "请输入 API Key")
            return
            
        self.log("正在连接 DeepSeek API...")
        
        # 简化的提示词
        prompt = "请写一段人民日报风格的今日社评"
        result = self.call_deepseek_api(api_key, prompt)
        
        if "ERROR" not in result:
            self.log("生成完成，正在保存...")
            filename = f"社评_{datetime.datetime.now().strftime('%Y%m%d')}.txt"
            with open(filename, 'w', encoding='utf-8') as f:
                f.write(result)
            self.log(f"文件已保存：{filename}")
        else:
            self.log(f"错误：{result}")


