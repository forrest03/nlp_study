        self.news_input = tk.Text(root, height=10, width=65, 
                                  font=("SimSun", 10), wrap=tk.WORD)
        self.news_input.pack(pady=5, padx=20)
        
        self.run_btn = tk.Button(root, text="🚀 生成社评并归档 (1450-1550字)", 
                                 font=("SimHei", 14, "bold"),
                                 bg="#0055AA", fg="white",
                                 command=self.run_agent)
        self.run_btn.pack(pady=15)
        
        self.log_area = tk.scrolledtext.ScrolledText(root, width=70, height=12)
        self.log_area.pack(pady=10)
        
    def log(self, message):
        self.log_area.insert(tk.END, f"[{datetime.datetime.now().strftime('%H:%M:%S')}] {message}\n")
        self.log_area.see(tk.END)
        self.root.update()
        
    def call_api(self, api_key, messages, max_tokens=2500):
        """V4.0 通用 API 调用"""
        url = "https://api.deepseek.com/chat/completions"
        headers = {
            "Content-Type": "application/json",
            "Authorization": f"Bearer {api_key}"
        }
        payload = {
            "model": "deepseek-chat",
            "messages": messages,
            "temperature": 0.7,
            "max_tokens": max_tokens
        }
        
        try:
            response = requests.post(url, headers=headers, json=payload, timeout=120)
            response.raise_for_status()
            return response.json()['choices'][0]['message']['content']
        except Exception as e:
            return f"API_ERROR: {str(e)}"
            
    def get_event_summary(self, news_content, api_key):
        """V4.0 核心：AI 自动提取摘要"""
        prompt = f"用不超过15字概括核心事件，不要标点：\n{news_content}"
        messages = [
            {"role": "system", "content": "你是新闻编辑，擅长精准概括。"},
            {"role": "user", "content": prompt}
        ]
        return self.call_api(api_key, messages, max_tokens=50)
        
    def sanitize_filename(self, name):
        """V4.0 新增：文件名清理"""
        import re
        return re.sub(r'[\\/:*?"<>|]', '', name).strip()
        
    def run_agent(self):
        api_key = self.api_entry.get().strip()
        if not api_key:
            messagebox.showerror("错误", "请输入 API Key")
            return
            
        news_content = self.news_input.get("1.0", tk.END).strip()
        if not news_content:
            messagebox.showerror("错误", "请输入新闻内容")
            return
            
        self.log("正在分析新闻素材...")
        
        # V4.0 分两步：先摘要，后正文
        summary = self.get_event_summary(news_content, api_key)
        if "API_ERROR" in summary:
            self.log(f"摘要生成失败: {summary}")
            return
            
        summary = summary.replace("\n", "").strip()
        self.log(f"事件摘要：{summary}")
        
        self.log("正在撰写正文...")
        
        system_prompt = "你是人民日报评论员，撰写1450-1550字社论。"
        messages = [
            {"role": "system", "content": system_prompt},
            {"role": "user", "content": f"素材：{news_content}"}
        ]
        
        article = self.call_api(api_key, messages)
        
        if "API_ERROR" not in article:
            word_count = len(article.replace("\n", "").replace(" ", ""))
            self.log(f"正文完成，字数：{word_count}")
            
            # V4.0 核心：精确时间戳命名
            now = datetime.datetime.now()
            time_str = now.strftime("%Y年%m月%d日%H时%M分%S秒")
            clean_summary = self.sanitize_filename(summary)
            filename = f"{time_str}社评—{clean_summary}.txt"
            
            with open(filename, 'w', encoding='utf-8') as f:
                f.write(article)
                
            self.log(f"文件已保存：{filename}")
            messagebox.showinfo("完成", f"字数：{word_count}\n文件：{filename}")
        else:
            self.log(f"错误：{article}")


