                                font=("SimHei", 14, "bold"),
                                bg="#27ae60", fg="white",
                                command=self.run_generation)
        self.run_btn.pack(pady=20)
        
        self.log_area = tk.scrolledtext.ScrolledText(root, width=70, height=10, font=("Consolas", 10))
        self.log_area.pack(pady=10)
        
    def log(self, message):
        self.log_area.insert(tk.END, f"[{datetime.datetime.now().strftime('%H:%M:%S')}] {message}\n")
        self.log_area.see(tk.END)
        self.root.update()
        
    def call_api(self, api_key, prompt, max_tokens=4000):
        """V5.0 API 调用"""
        url = "https://api.deepseek.com/chat/completions"
        headers = {
            "Content-Type": "application/json",
            "Authorization": f"Bearer {api_key}"
        }
        payload = {
            "model": "deepseek-chat",
            "messages": [{"role": "user", "content": prompt}],
            "temperature": 0.7,
            "max_tokens": max_tokens
        }
        
        try:
            response = requests.post(url, headers=headers, json=payload, timeout=180)
            response.raise_for_status()
            return response.json()['choices'][0]['message']['content']
        except Exception as e:
            return f"API_ERROR: {str(e)}"
            
    def process_news(self, api_key, content):
        """V5.0 时事评论处理"""
        self.log("已选择：时事评论模式")
        
        # 生成摘要
        summary = self.call_api(api_key, f"用15字概括事件：\n{content}", max_tokens=50)
        if "API_ERROR" in summary: return None, None
        summary = summary.replace("\n", "")
        self.log(f"事件摘要：{summary}")
        
        # 生成正文
        prompt = f"""
你是人民日报评论员。撰写社论：
- 政治站位高，逻辑严密
- 字数严格 1450-1550 字
素材：{content}
"""
        self.log("正在撰写社论...")
        article = self.call_api(api_key, prompt, max_tokens=2500)
        
        now = datetime.datetime.now()
        time_str = now.strftime("%Y年%m月%d日%H时%M分%S秒")
        return article, f"{time_str}社评—{summary}.txt"
        
    def process_book(self, api_key, content):
        """V5.0 书评处理"""
        self.log("已选择：文艺书评模式")
        self.log("正在构思文艺标题...")
        
        # 生成文艺标题
        outline_prompt = f"""
你是文学评论家。根据书籍信息：
1. 拟定一个文艺范标题（10字内）
2. 制定5000字大纲
书籍：{content}
只返回标题和大纲。
"""
        outline_result = self.call_api(api_key, outline_prompt)
        
        # 提取标题
        title_line = outline_result.split("\n")[0]
        import re
        clean_title = re.sub(r'[\\/:*?"<>|，。！？]', '', title_line).strip()
        if not clean_title: clean_title = "时光深处的回响"
        
        self.log(f"拟写标题：《{clean_title}》")
        
        # V5.0 特点：分段生成长文
        self.log("正在撰写第一部分...")
        part1 = self.call_api(api_key, 
            f"根据大纲撰写书评第一部分（引言），1500字：\n{outline_result}", 
            max_tokens=2500)
            
        self.log("正在撰写第二部分...")
        part2 = self.call_api(api_key,
            f"根据大纲撰写书评第二部分（核心），2000字：\n{outline_result}",
            max_tokens=3000)
            
        self.log("正在撰写第三部分...")
        part3 = self.call_api(api_key,
            f"根据大纲撰写书评第三部分（结语），1500字：\n{outline_result}",
            max_tokens=2500)
            
        full_article = f"{part1}\n\n{part2}\n\n{part3}"
        
        now = datetime.datetime.now()
        time_str = now.strftime("%Y年%m月%d日%H时%M分%S秒")
        return full_article, f"{time_str}书评—{clean_title}.txt"
        
    def run_generation(self):
        api_key = self.api_entry.get().strip()
        if not api_key:
            messagebox.showerror("错误", "请输入 API Key")
            return
            
        content = self.text_input.get("1.0", tk.END).strip()
        if not content:
            messagebox.showerror("错误", "请输入内容")
            return
            
        self.run_btn.config(state=tk.DISABLED, text="正在生成中...")
        
        try:
            mode = self.mode_var.get()
            
            if mode == "news":
                article, filename = self.process_news(api_key, content)
            else:
                article, filename = self.process_book(api_key, content)
                
            if article and "API_ERROR" not in article:
                folder = "写作助手输出"
                if not os.path.exists(folder): os.makedirs(folder)
                path = os.path.join(folder, filename)
                
                with open(path, 'w', encoding='utf-8') as f:
                    f.write(article)
                    
                wc = len(article.replace(" ", "").replace("\n", ""))
                self.log(f"文件已保存: {filename}")
                messagebox.showinfo("完成", f"字数：{wc}\n文件：{filename}")
            else:
                messagebox.showerror("失败", f"错误：{article}")
        finally:
            self.run_btn.config(state=tk.NORMAL, text="🚀 开始智能生成")


