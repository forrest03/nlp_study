        # API Key
        frame_api = tk.Frame(root)
        frame_api.pack(pady=5, fill=tk.X, padx=20)
        tk.Label(frame_api, text="DeepSeek API Key:").pack(side=tk.LEFT)
        self.api_entry = tk.Entry(frame_api, width=40, show="*")
        self.api_entry.pack(side=tk.LEFT, padx=5)
        
        # V3.0 核心：用户输入区
        tk.Label(root, text="👇 请输入新闻热点 (300字内)：", 
                font=("SimSun", 11, "bold")).pack(pady=10)
        
        self.news_input = tk.Text(root, height=5, width=60, font=("SimSun", 10))
        self.news_input.pack(pady=5, padx=20)
        
        self.run_btn = tk.Button(root, text="🚀 开始写作 (1450-1550字)", 
                                 font=("SimHei", 14, "bold"),
                                 bg="#0055AA", fg="white",
                                 command=self.run_agent)
        self.run_btn.pack(pady=15)
        
        # V3.0 新增：日志区域
        self.log_area = tk.scrolledtext.ScrolledText(root, width=70, height=12)
        self.log_area.pack(pady=10)
        
    def log(self, message):
        self.log_area.insert(tk.END, f"[{datetime.datetime.now().strftime('%H:%M:%S')}] {message}\n")
        self.log_area.see(tk.END)
        self.root.update()
        
    def call_deepseek_api(self, api_key, prompt_content):
        """V3.0 API 调用 - 增加字数控制"""
        url = "https://api.deepseek.com/chat/completions"
        headers = {
            "Content-Type": "application/json",
            "Authorization": f"Bearer {api_key}"
        }
        
        system_prompt = """
你是人民日报评论员。撰写社论时：
1. 站位要高，视野要宽
2. 语言精粹，善用修辞
3. 字数严格控制在 1450-1550 字之间
"""
        
        payload = {
            "model": "deepseek-chat",
            "messages": [
                {"role": "system", "content": system_prompt},
                {"role": "user", "content": prompt_content}
            ],
            "temperature": 0.7,
            "max_tokens": 2500
        }
        
        try:
            response = requests.post(url, headers=headers, json=payload, timeout=120)
            response.raise_for_status()
            return response.json()['choices'][0]['message']['content']
        except Exception as e:
            return f"API_ERROR: {str(e)}"
            
    def run_agent(self):
        api_key = self.api_entry.get().strip()
        if not api_key:
            messagebox.showerror("错误", "请输入 API Key")
            return
            
        news_content = self.news_input.get("1.0", tk.END).strip()
        if not news_content:
            messagebox.showerror("错误", "请输入新闻内容")
            return
            
        self.log("收到新闻素材，开始生成...")
        
        prompt = f"新闻素材：{news_content}\n请撰写社论，字数1450-1550字。"
        result = self.call_deepseek_api(api_key, prompt)
        
        if "API_ERROR" not in result:
            word_count = len(result.replace("\n", "").replace(" ", ""))
            self.log(f"生成完成，字数：{word_count}")
            
            # V3.0 保存逻辑
            filename = f"社评_{datetime.datetime.now().strftime('%Y%m%d_%H%M%S')}.txt"
            with open(filename, 'w', encoding='utf-8') as f:
                f.write(result)
            self.log(f"文件已保存：{filename}")
        else:
            self.log(f"错误：{result}")


