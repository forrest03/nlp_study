    @classmethod
    def extract(cls, text: str) -> Set[str]:
        """
        逻辑：
        1. 【核心】使用 jieba.posseg 进行词性标注，只保留 nr/nrf（人名）标签。
           jieba 的 HMM 模型经过海量语料训练，不会把"什么/知道/说道"等词误判为人名。
        2. 过滤停用词（二次保险）。
        3. 出现次数少于 3 次的去掉（消除 jieba 偶发的边界误识别）。
        """
        try:
            import jieba.posseg as pseg
        except ImportError:
            print("\n[SmartNameExtractor] ❌ 未检测到 jieba，请先安装：")
            print("    pip install jieba")
            print("[SmartNameExtractor] 回退到旧版规则提取（幻觉较多）...\n")
            return cls._fallback_extract(text)

        # 1. jieba 词性标注提取人名
        words = pseg.cut(text)
        name_candidates = Counter()

        for word, flag in words:
            # jieba 人名标签：nr(普通人名), nrf(外国人名), nrfg(古语人名)
            if flag.startswith('nr'):
                name_candidates[word] += 1

        # 2. 二次过滤
        valid_names = set()
        for word, count in name_candidates.items():
            if word in cls.STOP_WORDS:
                continue
            if count < 3:
                continue
            valid_names.add(word)

        print(f"[SmartNameExtractor] jieba 原始提取 {len(name_candidates)} 个候选，过滤后保留 {len(valid_names)} 个真实人名")
        return valid_names

    @classmethod
    def _fallback_extract(cls, text: str) -> Set[str]:
        """
        回退方案：当 jieba 未安装时使用原版的正则提取逻辑。
        保留此函数仅作为兼容性回退，强烈建议安装 jieba 以获得最佳效果。
        """
        raw_tokens = re.findall(r'[\u4e00-\u9fff]{2,4}', text)
        word_counts = Counter(raw_tokens)
        valid_names = set()

        for word, count in word_counts.items():
            if word in cls.STOP_WORDS:
                continue
            if len(word) == 2 and word[0] in {'不', '是', '非', '于', '以', '之'}:
                continue
            if count < 3:
                continue
            if len(word) == 4 and count < 5:
                continue
            valid_names.add(word)

        print(f"[SmartNameExtractor] 【回退模式】正则提取 {len(valid_names)} 个候选（可能有幻觉）")
        return valid_names

