class BookAnalysisAgent(BaseAgent):
    def __init__(self, agent_id: str, message_bus: MessageBus, book_name: str, file_path: str):
        super().__init__(agent_id, message_bus)
        self.book_name = book_name
        self.file_path = file_path
        self.content = ""
        self.valid_names: Set[str] = set()
        self.relationships = defaultdict(int)
        self.graph = nx.Graph()

    def process_message(self, message: Message):
        if message.msg_type == "STOP":
            self.stop()

    def process_book(self):
        print(f"\n[{self.agent_id}] 开始分析 {self.book_name}")

        # 1. 读取文件
        if not os.path.exists(self.file_path):
            print(f"[{self.agent_id}] 错误：文件不存在")
            self.send_message("MasterAgent", "TASK_COMPLETE", {"error": "文件不存在"})
            return

        try:
            with open(self.file_path, 'r', encoding='utf-8') as f:
                self.content = f.read()
        except UnicodeDecodeError:
            with open(self.file_path, 'r', encoding='gb18030') as f:
                self.content = f.read()

        # 2. 提取真实人名 (使用 jieba 词性标注，彻底消除幻觉)
        print(f"[{self.agent_id}] 正在提取人名...")
        self.valid_names = SmartNameExtractor.extract(self.content)
        print(f"[{self.agent_id}] 成功提取 {len(self.valid_names)} 个真实人物 (已过滤幻觉)")

        if len(self.valid_names) == 0:
            print(f"[{self.agent_id}] 警告：没有提取到有效人名！")
            self.send_message("MasterAgent", "TASK_COMPLETE", {"error": "没有提取到有效人名"})
            return

        # 3. 分析共现关系 (放宽阈值确保有连线)
        print(f"[{self.agent_id}] 正在分析人物关系...")
        self.analyze_cooccurrence()
        print(f"[{self.agent_id}] 提取到 {len(self.relationships)} 对有效关系")

        # 4. 构建知识图谱
        self.build_graph()
        print(f"[{self.agent_id}] 构建图: {self.graph.number_of_nodes()} 节点, {self.graph.number_of_edges()} 条边")

        # 5. 生成可视化
        html_file = self.visualize_graph()

        result = {
            "status": "completed",
            "book_name": self.book_name,
            "node_count": self.graph.number_of_nodes(),
            "edge_count": self.graph.number_of_edges(),
            "html_file": html_file
        }

        self.send_message("MasterAgent", "TASK_COMPLETE", result)
        print(f"[{self.agent_id}] 完成分析!\n")

    def analyze_cooccurrence(self):
        """分析共现关系"""
        sentences = re.split(r'[。！？；\n]+', self.content)
        name_list = list(self.valid_names)

        for sent in sentences:
            if not sent.strip() or len(sent) < 5:
                continue

            found = []
            for name in name_list:
                if name in sent:
                    found.append(name)

            if len(found) >= 2:
                found = sorted(found)
                for i in range(len(found)):
                    for j in range(i + 1, len(found)):
                        pair = (found[i], found[j])
                        self.relationships[pair] += 1

    def build_graph(self):
        """构建图 - 修复连线断裂问题"""
        # 关键修复：不丢弃任何节点，只要是提取出来的真实人物全都保留
        for name in self.valid_names:
            self.graph.add_node(name)

        # 只要共现次数 ≥ 1，就连接。确保所有人物有关系可循
        for (char1, char2), weight in self.relationships.items():
            self.graph.add_edge(char1, char2, weight=weight)

    def visualize_graph(self) -> str:
        """生成动态 Pyvis HTML"""
        if self.graph.number_of_nodes() == 0:
            return None

        net = Network(height="100vh", width="100%", bgcolor="#0a0a1a", font_color="#e0e0e0")

        degree_dict = dict(self.graph.degree())
        max_degree = max(degree_dict.values()) if degree_dict else 1

        # 计算节点大小
        for node in self.graph.nodes():
            degree = degree_dict.get(node, 0)
            size = 15 + (degree / max_degree) * 40  # 节点随关系增多而变大

            # 随机生成鲜艳颜色（幻觉和虚空节点消失，不用担心颜色混乱，可以用彩虹色系）
            # 为高亮人物使用不同的颜色区分
            net.add_node(
                node,
                label=node,
                size=size,
                title=f"人物: {node}\n关联人数: {degree}",
                font={'size': 14, 'face': 'Microsoft YaHei', 'strokeWidth': 2, 'strokeColor': '#000000'}
            )

        # 添加边 (关系次数越强线越粗)
        for edge in self.graph.edges(data=True):
            weight = edge[2].get('weight', 1)
            width = 1 + (weight / 10) * 3 # 动态调节线宽

            net.add_edge(
                edge[0],
                edge[1],
                value=weight,
                title=f"共现次数: {weight}",
                width=min(width, 10),
                color={'color': '#a6c8ff', 'opacity': 0.7}
            )

        # 核心物理引擎（永动效果）
        net.barnes_hut(
            gravity=-8000,
            central_gravity=0.3,
            spring_length=250,
            damping=0.09,
            overlap=0.1
        )

        net.set_options("""
        {
          "nodes": {
            "shadow": true,
            "borderWidth": 2
          },
          "edges": {
            "smooth": {"enabled": true, "type": "dynamic"}
          },
          "physics": {
            "enabled": true,
            "stabilization": {"iterations": 150}
          },
          "interaction": {
            "hover": true,
            "navigationButtons": true,
            "keyboard": true,
            "tooltipDelay": 200,
            "dragNodes": true
          }
        }
        """)

        output_file = f"KG_{self.book_name}_Fixed.html"
        net.save_graph(output_file)
        return os.path.abspath(output_file)

    def run(self):
        super().run()
        processing_thread = threading.Thread(target=self.process_book, daemon=True)
        processing_thread.start()

# ============================================================
# 主控智能体
# ============================================================
class MasterAgent(BaseAgent):
    def __init__(self, message_bus: MessageBus):
        super().__init__("MasterAgent", message_bus)
        self.sub_agents: Dict[str, BookAnalysisAgent] = {}
        self.pending_tasks = 0
        self.completed_tasks = 0
        self.results = {}

    def process_message(self, message: Message):
        if message.msg_type == "TASK_COMPLETE":
            self.results[message.sender] = message.content
            self.completed_tasks += 1
            if self.completed_tasks >= self.pending_tasks:
                self.aggregate_results()

    def discover_and_dispatch(self):
        print(f"\n[MasterAgent] 正在扫描目录: {BASE_PATH}")
        for book_info in BOOKS_CONFIG:
            file_path = os.path.join(BASE_PATH, book_info["file"])
            if os.path.exists(file_path):
                agent = BookAnalysisAgent(
                    agent_id=f"{book_info['name']}Agent",
                    message_bus=self.message_bus,
                    book_name=book_info["name"],
                    file_path=file_path
                )
                self.sub_agents[agent.agent_id] = agent
                agent.run()
                self.pending_tasks += 1
            else:
                print(f"[MasterAgent] 警告：文件不存在 {file_path}")

    def aggregate_results(self):
        print("\n" + "=" * 60)
        print("[MasterAgent] 所有任务结束！生成的动态图如下：")
        for agent_id, res in self.results.items():
            if "html_file" in res:
                print(f"  📊 {agent_id} : {res['html_file']} (节点:{res['node_count']}, 边:{res['edge_count']})")
        print("=" * 60 + "\n")
        # 自动停止所有代理
        for agent in self.sub_agents.values():
            agent.stop()
        self.stop()
        print("系统安全退出。")

    def run_system(self):
        self.run()
        self.discover_and_dispatch()
        while self.completed_tasks < self.pending_tasks:
            time.sleep(1)

